#!name=华住会小程序每日签到
#!desc=每天 08:05 使用本机保存的小程序 userToken 签到。
#!system=ios
#!category=华住会

[Script]
华住会签到（手动测试） = type=generic,script-path=https://raw.githubusercontent.com/Yoyyyyp/surge-huazhu/main/huazhu.js,timeout=20
华住会小程序每日签到 = type=cron,cronexp="5 8 * * *",script-path=https://raw.githubusercontent.com/Yoyyyyp/surge-huazhu/main/huazhu.js,wake-system=true,timeout=20
